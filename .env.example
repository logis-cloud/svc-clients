# Variables de entorno para ms-clientes (svc-clientes)
# Copiar este contenido a un archivo llamado ".env" en la raíz del repo
# (junto al docker-compose.yml)
 
# --- Base de datos MySQL ---
DB_USER=root
DB_PASSWORD=root123
# --- IP de la VM ---
# Para pruebas en local colocar 
DB_HOST=host.docker.internal
# DB_HOST=1221.21323.1 ip de la vm que contiene a las db's
DB_PORT=3306
DB_NAME=clientes_db
 
# --- CORS ---
# "*" para desarrollo local. En producción, reemplazar por el dominio
# real de Amplify (y localhost:5173 si sigues probando en local), separados
# por comas, ej:
# CORS_ALLOWED_ORIGINS=https://main.xxxx.amplifyapp.com,http://localhost:5173
CORS_ALLOWED_ORIGINS=*
 


